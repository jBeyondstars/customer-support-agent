OPENAI_API_KEY=

DATABASE_URL=postgresql://support:support@localhost:55432/support

# Any provider supported by langchain's init_chat_model works here,
# as long as its package is installed and its API key is set.
CHAT_MODEL=openai:gpt-6-luna
JUDGE_MODEL=openai:gpt-6.1-sol
EMBEDDING_MODEL=openai:text-embedding-3-small

# At least 32 characters. To make one:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
